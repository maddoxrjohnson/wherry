domain          = "apps.example.com"
acme_email      = "you@example.com"
dashboard_host  = "example.com"
# Must ship wherry-update and wherry-backup, so v0.1.0-rc1 is too old.
release_version = "v0.1.0-rc2"
# Use ["0.0.0.0/0", "::/0"] with the deploy workflow: GitHub's runners have no
# fixed address. Servers built from this module have password login off.
admin_cidrs     = ["203.0.113.7/32"]
# t3.small works too; the AMI and the release follow the architecture.
instance_type   = "t4g.small"
region          = "us-east-2"
