[Unit]
Description=wherry deploy daemon
Documentation=https://github.com/maddoxrjohnson/wherry
# Docker takes the containers with it when it stops, and nothing else brings
# them back. Requires carries a Docker restart over to wherryd so it reconciles;
# WantedBy below covers the case Requires does not, Docker stopped and started.
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
# Keep trying: a port held for a minute should not need someone to log in.
StartLimitIntervalSec=0

[Service]
# wherryd does not speak sd_notify, so "started" means the binary was exec'd.
Type=exec
Environment=WHERRY_DATA_DIR=/var/lib/wherry
EnvironmentFile=/etc/wherry/env
ExecStart=/usr/local/bin/wherryd
Restart=always
RestartSec=5

# Runs as root with almost nothing a root process normally has. The Docker
# socket is root-equivalent anyway, so a separate user would add little.
# This unit is for the Docker runtime only: the native runtime needs
# namespaces, a cgroup subtree, and capabilities that are all removed here.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
StateDirectory=wherry
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target docker.service
