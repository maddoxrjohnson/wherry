# Copy to /etc/wherry/env, mode 0600. Do not set WHERRY_DATA_DIR here: the unit
# only makes /var/lib/wherry writable.
WHERRY_DOMAIN=apps.example.com
WHERRY_HTTP_ADDR=:80
WHERRY_HTTPS_ADDR=:443
WHERRY_ACME_EMAIL=you@example.com
# Serve the dashboard publicly at this hostname, over HTTPS. Unset, it stays internal.
# WHERRY_DASHBOARD_HOST=example.com
